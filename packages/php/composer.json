{
  "name": "xrpm-login/sdk",
  "description": "Sign In With XRPM — PHP SDK for partner websites (Laravel, WordPress, plain PHP)",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/xrpmemes/xrpm-login",
  "keywords": ["xrpm", "xrpl", "signin", "authentication", "web3", "wallet"],
  "require": {
    "php": ">=8.1",
    "ext-sodium": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "simplito/elliptic-php": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "XrpmLogin\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "XrpmLogin\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit tests/"
  }
}
