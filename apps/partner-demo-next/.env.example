# ─── Required ─────────────────────────────────────────────────────────────────

# Public URL of your site. Used as the challenge `aud` and base for redirect_uri.
# Must be HTTPS in production (http://localhost:3000 is allowed for development).
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# ─── Nonce Store (pick one) ───────────────────────────────────────────────────

# Option A — Redis (recommended for production)
# Replace the MemoryNonceStore in lib/nonceStore.ts with RedisNonceStore
REDIS_URL=redis://localhost:6379

# Option B — PostgreSQL
# Replace with PostgresNonceStore
DATABASE_URL=postgresql://user:password@localhost:5432/xrpm_login

# ─── Session ──────────────────────────────────────────────────────────────────

# Used to sign session cookies (if you switch to iron-session or similar)
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Optional ─────────────────────────────────────────────────────────────────

# Override the XRPL public node (default: https://xrplcluster.com)
# XRPL_ENDPOINT=https://xrplcluster.com
